{
  "name": "jas-loyalty-engine-micro",
  "version": "1.0.0",
  "description": "Monolithic minimum product loyalty engine",
  "author": "Jaswinder Singh <jaswindersingh11061998@gmail.com>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "depsInstall": "npm install && npm run db && npm run update-db-schema && npm run build",
    "build": "npx @nestjs/cli build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "update-db-schema": "npx prisma db push",
    "update-db-schema-with-loss": "npx prisma db push --accept-data-loss",
    "db": "npx prisma generate --schema=./prisma/schema.prisma",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky install",
    "docker:build": "docker compose up -d --build",
    "migrate-deploy": "npx prisma migrate deploy",
    "migrate-dev": "npx prisma migrate dev --name init",
    "resolve-migrations": "npx prisma migrate resolve --applied 0_init_full"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^1.9.1",
    "@nestjs/axios": "^3.0.1",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/swagger": "^7.1.13",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^4.2.1",
    "@prisma/client": "^5.4.1",
    "@redis/client": "^1.6.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "await-to-js": "^3.0.0",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.13",
    "firebase-admin": "^12.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "joi": "^17.11.0",
    "nest-winston": "^1.9.7",
    "nestjs-pino": "^4.0.0",
    "pg": "^8.14.1",
    "pg-boss": "^10.4.2",
    "pino": "^8.20.0",
    "pino-loki": "^2.2.1",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.4.1",
    "prom-client": "^15.1.3",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "winston-loki": "^6.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/cache-manager-redis-store": "^2.0.3",
    "@types/express": "^4.17.13",
    "@types/hapi__joi": "^17.1.11",
    "@types/jest": "29.2.4",
    "@types/node": "18.11.18",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^9.1.4",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
