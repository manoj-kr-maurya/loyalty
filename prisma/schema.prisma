// This is your Prisma schema file,
// learn more about it in the docs https//pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LSB_PG_URL")
}

// --------------------------------------------------------
// Models -----------------------------
// --------------------------------------------------------

model Organization {
  id   String  @id @default(uuid())
  name String?

  phoneNumber        String                      @unique()
  countryCode        String
  isVerified         Boolean                     @default(false)
  kycStatus          Boolean                     @default(false)
  token              String                      @default("")
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  isSoftDeleted      Boolean                     @default(false)
  metaFlags          MetaFlagsForOrganization?
  role               OrganizationRoles           @default(ADMIN)
  orgAdminId         String?
  fcmToken           String?
  address            String?
  logoUrl            String?
  coverUrl           String?
  upiURI             String?
  operationalHours   String?
  aboutUs            String?
  contactUs          String?
  currencies         Currency[]
  currencyBuckets    CurrencyBucket[] // decoupling of currency buckets from currency so that an org can use another org's currencny.
  organizationOrders OrganizationOrder[]
  campaigns          OrganizationCampaign[]
  customerOrgOrders  CustomerOrganizationOrder[]
  rewardPrograms     RewardProgram[]
  apiKeys            OrganizationApiKey[]

  @@index([phoneNumber])
  @@index([countryCode])
  @@map("organization")
}

model MetaFlagsForOrganization {
  id                        String       @id @default(uuid())
  initJourneyCompleted      Boolean      @default(false)
  firstCampaignCreated      Boolean      @default(false)
  firstCurrencyAdded        Boolean      @default(false)
  firstCurrencyBalanceAdded Boolean      @default(false)
  organization              Organization @relation(fields: [organizationId], references: [id])
  organizationId            String       @unique

  @@map("metaFlagsForOrganization")
}

model Customer {
  id                String                      @id @default(uuid())
  name              String?
  phoneNumber       String                      @unique()
  countryCode       String
  isVerified        Boolean                     @default(false)
  metaFlags         MetaFlagsForCustomer?
  token             String                      @default("")
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  fcmToken          String?
  logoUrl           String?
  customerOrgOrders CustomerOrganizationOrder[]
  customerWallet    CustomerWallet[]
  couponCodes       CouponCode[]
  rewardBlocks      RewardBlock[]
  rewardLedgers     RewardLedger[]

  @@map("customer")
}

model MetaFlagsForCustomer {
  id                   String   @id @default(uuid())
  initJourneyCompleted Boolean  @default(false)
  customer             Customer @relation(fields: [customerId], references: [id])
  customerId           String   @unique

  @@map("metaFlagsForCustomer")
}

model OrganizationApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String?
  prefix         String       @unique
  keyHash        String       @unique
  scopes         String[]     @default([])
  isActive       Boolean      @default(true)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
  @@map("organizationApiKey")
}

model OrganizationCampaign {
  id                String       @id @default(uuid())
  organization      Organization @relation(fields: [organizationId], references: [id])
  organizationId    String
  name              String
  earningPercentage Int
  currencyCode      String
  startDate         DateTime     @default(now())
  endDate           DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  isSoftDeleted     Boolean      @default(false)

  earningExpiresIn         Int                       @default(30)
  earningCoinAmountDetails EarningCoinAmountDetail[]

  @@unique([organizationId, name], name: "unique_organization_campaign_name")
  @@index([organizationId], name: "organization_campaign_idx")
  @@map("organizationCampaign")
}

model Currency {
  id             String         @id @default(uuid())
  name           String
  code           String
  symbol         String         @default("_")
  exchangeRates  ExchangeRate[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String

  @@unique([organizationId, code], name: "organization_id_currency_code_currency")
  @@map("currency")
}

model ExchangeRate {
  id                   String   @id @default(uuid())
  currency             Currency @relation(fields: [currencyId], references: [id])
  currencyId           String
  physicalCurrencyCode String   @default("INR")
  rate                 Decimal  @default(1) @db.Decimal(10, 6)
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  @@unique([currencyId, physicalCurrencyCode], name: "currency_id_physical_currency_code")
  @@map("exchangeRate")
}

model CurrencyBucket {
  id                String                      @id @default(uuid())
  code              String
  availableAmount   Int                         @default(0)
  distributedAmount Int                         @default(0)
  receivedAmount    Int                         @default(0)
  organization      Organization                @relation(fields: [organizationId], references: [id])
  organizationId    String
  transactions      CurrencyBucketTransaction[]

  // Auto Top-Up Fields
  autoTopUpEnabled   Boolean @default(false)
  autoTopUpThreshold Int? // Trigger balance for top-up
  autoTopUpAmount    Int? // Amount to top up

  @@unique([organizationId, code], name: "organization_id_currency_code")
  @@map("currencyBucket")
}

model CurrencyBucketTransaction {
  id               String                                @id @default(uuid())
  currencyBucketId String
  amount           Int
  status           CustomerWalletPocketTransactionStatus
  transactionRef   String
  reversalTime     DateTime?
  createdAt        DateTime                              @default(now())
  updatedAt        DateTime                              @updatedAt
  currencyBucket   CurrencyBucket                        @relation(fields: [currencyBucketId], references: [id])

  @@map("currencyBucketTransaction")
}

model OrganizationOrder {
  id                 String                           @id @default(uuid())
  organizationId     String
  transactionId      String
  orderType          OrganizationOrderType
  orderStatus        OrganizationOrderStatus
  details            OrderDetails?
  paymentReference   String?                          @unique
  paymentAmount      Float?
  paymentProvider    String?
  paymentConfirmedAt DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  amount             Float
  statusHistory      OrganizationOrderStatusHistory[]
  organization       Organization                     @relation(fields: [organizationId], references: [id])

  @@index([organizationId, orderStatus])
  @@map("organizationOrder")
}

model OrganizationOrderStatusHistory {
  id                  String                  @id @default(uuid())
  status              OrganizationOrderStatus
  timestamp           DateTime
  organizationOrder   OrganizationOrder       @relation(fields: [organizationOrderId], references: [id])
  organizationOrderId String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@map("organizationOrderStatusHistory")
}

model OrderDetails {
  id                  String            @id @default(uuid())
  currencyCode        String
  organizationOrder   OrganizationOrder @relation(fields: [organizationOrderId], references: [id])
  organizationOrderId String            @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("orderDetail")
}

model CustomerWallet {
  id               String                 @id @default(uuid())
  availableBalance Int                    @default(0)
  blockedBalance   Int                    @default(0)
  pendingBalance   Int                    @default(0)
  usedBalance      Int                    @default(0)
  expiredBalance   Int                    @default(0)
  customer         Customer               @relation(fields: [customerId], references: [id])
  customerId       String
  organizationId   String
  currencyCode     String
  pockets          CustomerWalletPocket[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([customerId, organizationId, currencyCode], name: "customer_id_organization_currency_code")
  @@index([customerId])
  @@index([organizationId])
  @@index([currencyCode])
  @@map("customerWallet")
}

model CustomerWalletPocket {
  id               String                            @id @default(uuid())
  customerWalletId String
  availableBalance Int                               @default(0)
  blockedBalance   Int                               @default(0)
  pendingBalance   Int                               @default(0)
  usedBalance      Int                               @default(0)
  expiredBalance   Int                               @default(0)
  expiryDate       DateTime?
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  customerWallet   CustomerWallet                    @relation(fields: [customerWalletId], references: [id])
  transactions     CustomerWalletPocketTransaction[]

  @@index([customerWalletId])
  @@map("customerWalletPocket")
}

// Rule 1: sum of all credit entries' availableReversalBalance should be equal to customerWallet's AvailableBalance

model CustomerWalletPocketTransaction {
  id                     String                                @id @default(uuid())
  customerWalletPocketId String
  amount                 Int
  status                 CustomerWalletPocketTransactionStatus
  transactionRef         String
  createdAt              DateTime                              @default(now())
  updatedAt              DateTime                              @updatedAt
  customerWalletPocket   CustomerWalletPocket                  @relation(fields: [customerWalletPocketId], references: [id])

  @@unique([customerWalletPocketId, transactionRef], name: "wallet_pocket_transaction_ref")
  @@index([customerWalletPocketId])
  @@map("customerWalletPocketTransaction")
}

model RewardProgram {
  id                 String              @id @default(uuid())
  organization       Organization        @relation(fields: [organizationId], references: [id])
  organizationId     String
  name               String
  description        String?
  programType        RewardProgramType
  rewardType         RewardType
  status             RewardProgramStatus @default(ACTIVE)
  rewardCurrency     String
  budgetEnabled      Boolean             @default(false)
  expiryNotification Boolean             @default(false)
  priority           Int                 @default(0)
  business           String?
  category           String?
  couponCode         String?
  couponValue        Decimal?            @db.Decimal(12, 2)
  subTitle           String?
  minBankAmount      Decimal?            @db.Decimal(12, 2)
  minimumCartValue   Decimal?            @db.Decimal(12, 2)
  maxDiscountValue   Decimal?            @db.Decimal(12, 2)
  discountType       String?
  isStackable        Boolean             @default(false)
  applicableProducts Json?
  businessType       Json?
  maxClaimsPerUser   Int?
  maxClaimsTotal     Int?
  attributes         Json?
  channels           Channel[]
  startDate          DateTime            @default(now())
  endDate            DateTime            @default(now())
  timezone           String?             @default("UTC")
  blackoutDates      Json?
  workingDays        Json?
  dailyTimeSlots     Json?
  version            Int                 @default(1)
  isArchived         Boolean             @default(false)
  rules              RewardProgramRule[]
  couponCodes        CouponCode[]
  rewardBlocks       RewardBlock[]
  rewardLedgers      RewardLedger[]
  budgets            Budget[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("rewardProgram")
}

model RewardProgramRule {
  id         String        @id @default(uuid())
  program    RewardProgram @relation(fields: [programId], references: [id])
  programId  String
  name       String
  conditions Json
  rewardType RewardType
  rewardMode RewardMode
  value      Decimal
  ratioBase  Decimal?
  threshold  Decimal?
  meta       Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("rewardProgramRule")
}

model CouponCode {
  id             String           @id @default(uuid())
  code           String           @unique
  program        RewardProgram    @relation(fields: [programId], references: [id])
  programId      String
  customer       Customer?        @relation(fields: [customerId], references: [id])
  customerId     String?
  isUserSpecific Boolean          @default(true)
  status         CouponCodeStatus @default(AVAILABLE)
  usedCount      Int              @default(0)
  maxUses        Int?             @default(1)
  perUserLimit   Int?
  allocatedAt    DateTime         @default(now())
  expiresAt      DateTime?
  rewardLedgers  RewardLedger[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([code])
  @@index([programId, customerId])
  @@map("couponCode")
}

model RewardBlock {
  id           String            @id @default(uuid())
  blockId      String            @unique
  program      RewardProgram     @relation(fields: [programId], references: [id])
  programId    String
  customer     Customer          @relation(fields: [customerId], references: [id])
  customerId   String
  awardDetails Json
  status       RewardBlockStatus @default(PENDING)
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("rewardBlock")
}

model RewardLedger {
  id             String             @id @default(uuid())
  customer       Customer           @relation(fields: [customerId], references: [id])
  customerId     String
  program        RewardProgram      @relation(fields: [programId], references: [id])
  programId      String
  couponCode     CouponCode?        @relation(fields: [couponCodeId], references: [id], onDelete: SetNull)
  couponCodeId   String?
  rewardType     RewardType
  amount         Decimal
  details        Json?
  transactionRef String?
  idempotencyKey String?            @unique
  status         RewardLedgerStatus @default(CREDITED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([couponCodeId])
  @@map("rewardLedger")
}

model Budget {
  id             String        @id @default(uuid())
  program        RewardProgram @relation(fields: [programId], references: [id])
  programId      String
  totalBudget    Decimal       @default(0)
  usedBudget     Decimal       @default(0)
  reservedBudget Decimal       @default(0)
  currency       String        @default("INR")
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([programId])
  @@map("budget")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String?
  action     String
  actor      String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("auditLog")
}

enum RewardProgramType {
  PROMO
  LOYALTY
}

enum Channel {
  APP
  WEB
  MWEB
  ALL
}

enum RewardType {
  COUPON
  DISCOUNT
  CASHBACK
  GIFT
  POINTS
  TIER_UPGRADE
  BADGE
  COINS
  CASHBACK_WALLET
  PERCENTAGE
  BUNDLE
}

enum RewardMode {
  RATIO
  ABSOLUTE
  PERCENTAGE
  MULTIPLIER
  SLAB
  MILESTONE
}

enum RewardProgramStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RewardBlockStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum CouponCodeStatus {
  AVAILABLE
  BLOCKED
  CLAIMED
  EXPIRED
  REVOKED
}

enum RewardLedgerStatus {
  CREDITED
  DEBITED
  REVERSED
  EXPIRED
}

model CustomerOrganizationOrder {
  id                          String                                   @id @default(uuid())
  customerId                  String
  organizationId              String
  customerBurningAmountDetail CustomerBurningAmountDetail?
  physicalCurrency            String
  status                      CustomerOrganizationOrderStatus
  idempotencyKey              String?
  createdAt                   DateTime                                 @default(now())
  updatedAt                   DateTime                                 @updatedAt
  customerEarningAmountDetail CustomerEarningAmountDetail?
  statusHistory               CustomerOrganizationOrderStatusHistory[]
  organization                Organization                             @relation(fields: [organizationId], references: [id])
  customer                    Customer                                 @relation(fields: [customerId], references: [id])

  @@unique([customerId, idempotencyKey])
  @@index([customerId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("customerOrganizationOrder")
}

model CustomerEarningAmountDetail {
  id                          String                    @id @default(uuid())
  totalAmount                 Float
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  coin                        EarningCoinAmountDetail[]
  customerOrganizationOrder   CustomerOrganizationOrder @relation(fields: [customerOrganizationOrderId], references: [id])
  customerOrganizationOrderId String                    @unique

  @@map("customerEarningAmountDetail")
}

model CustomerBurningAmountDetail {
  id                          String                    @id @default(uuid())
  cash                        BurningCashAmountDetail?
  coin                        BurningCoinAmountDetail[]
  totalAmount                 Float
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  customerOrganizationOrder   CustomerOrganizationOrder @relation(fields: [customerOrganizationOrderId], references: [id])
  customerOrganizationOrderId String                    @unique

  @@map("customerBurningAmountDetail")
}

model BurningCashAmountDetail {
  id                            String                      @id @default(uuid())
  amount                        Float
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  customerBurningAmountDetail   CustomerBurningAmountDetail @relation(fields: [customerBurningAmountDetailId], references: [id])
  customerBurningAmountDetailId String                      @unique

  @@map("burningCashAmountDetail")
}

model EarningCoinAmountDetail {
  id                            String                      @id @default(uuid())
  currencyCode                  String
  amount                        Float
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  customerEarningAmountDetail   CustomerEarningAmountDetail @relation(fields: [customerEarningAmountDetailId], references: [id])
  customerEarningAmountDetailId String
  earningExpiresIn              Int
  organizationCampaignId        String?
  organizationCampaign          OrganizationCampaign?       @relation(fields: [organizationCampaignId], references: [id])

  @@map("earningCoinAmountDetail")
}

model BurningCoinAmountDetail {
  id                            String                      @id @default(uuid())
  currencyCode                  String
  amount                        Int
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  customerBurningAmountDetail   CustomerBurningAmountDetail @relation(fields: [customerBurningAmountDetailId], references: [id])
  customerBurningAmountDetailId String                      @unique

  @@map("burningCoinAmountDetail")
}

model CustomerOrganizationOrderStatusHistory {
  id                          String                          @id @default(uuid())
  status                      CustomerOrganizationOrderStatus
  timestamp                   DateTime
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  customerOrganizationOrder   CustomerOrganizationOrder       @relation(fields: [customerOrganizationOrderId], references: [id])
  customerOrganizationOrderId String

  @@map("customerOrganizationOrderStatusHistory")
}

model Invite {
  id          String            @id @default(uuid())
  isUsed      Boolean           @default(false)
  assignedTo  String            @unique
  location    String
  generatedBy String
  orgAdminId  String?
  role        OrganizationRoles @default(SHOP)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("invite")
}

model Interest {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("interest")
}

// --------------------------------------------------------
// Types -----------------------------
// --------------------------------------------------------

// --------------------------------------------------------
// Enums -----------------------------
// --------------------------------------------------------

enum PointTypes {
  AVAILABLE
  BLOCKED
  PENDING
}

enum CustomerOrganizationOrderStatus {
  INITIATED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  HOLD
}

enum AccountType {
  CHECKING
  SAVINGS
}

enum OrganizationOrderType {
  CURRENCY_PURCHASE
  // Future order types can be added here
}

enum PayoutMethod {
  BANK_TRANSFER
  PAYPAL
  CRYPTO_WALLET
  DEBIT_CARD
}

enum PayoutFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum NotificationPreference {
  EMAIL
  SMS
  PUSH_NOTIFICATION
}

enum TemplateType {
  TRANSACTIONAL
  PROMOTIONAL
}

enum TemplateSubtype {
  CUSTOMER_LOGIN_OTP
  ORGANIZATION_LOGIN_OTP
}

enum OrganizationOrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  DISPUTED
  HOLD
}

enum PaymentGateways {
  PHONEPE
  GPAY
  PAYTM
  STRIPE
  PAYPAL
}

enum CustomerWalletPocketTransactionStatus {
  BLOCKED
  UNBLOCKED
  AWARDED
  CREDITED
  PENDING
  EXPIRED
  DEBITED
  CANCELLED
}

enum OrganizationRoles {
  ADMIN
  SHOP
}

// --------------------------------------------------------
// Productised Commercial Engines — New Models
// --------------------------------------------------------

// ─── FX / Currency Engine ───────────────────────────────

model ExchangeRateHistory {
  id                   String    @id @default(uuid())
  currencyId           String
  physicalCurrencyCode String    @default("INR")
  rate                 Decimal   @db.Decimal(10, 6)
  source               String    @default("MANUAL") // MANUAL | API_PROVIDER | CENTRAL_BANK
  lockedBy             String? // userId who locked the rate
  lockedUntil          DateTime?
  consumedAt           DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())

  @@index([currencyId, physicalCurrencyCode])
  @@index([currencyId, physicalCurrencyCode, lockedUntil])
  @@index([createdAt])
  @@map("exchangeRateHistory")
}

model FxAuditLog {
  id           String   @id @default(uuid())
  referenceId  String // unique FX reference ID
  fromCurrency String
  toCurrency   String
  fromAmount   Decimal  @db.Decimal(18, 6)
  toAmount     Decimal  @db.Decimal(18, 6)
  rate         Decimal  @db.Decimal(10, 6)
  spread       Decimal  @default(0) @db.Decimal(10, 6)
  source       String   @default("MANUAL")
  tenantId     String?
  lockedRate   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([referenceId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("fxAuditRecord")
}

// ─── Loyalty Engine ─────────────────────────────────────

model LoyaltyTier {
  id             String         @id @default(uuid())
  organizationId String
  name           String // e.g., Silver, Gold, Platinum
  level          Int // 1, 2, 3...
  minPoints      Int            @default(0) // threshold to reach this tier
  maxPoints      Int? // ceiling (null = no ceiling)
  multiplier     Decimal        @default(1.0) @db.Decimal(5, 2) // earn multiplier
  benefits       Json? // tier-specific benefits
  color          String? // UI color
  iconUrl        String?
  isActive       Boolean        @default(true)
  customerTiers  CustomerTier[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("loyaltyTier")
}

model CustomerTier {
  id             String      @id @default(uuid())
  customerId     String
  organizationId String
  tierId         String
  tier           LoyaltyTier @relation(fields: [tierId], references: [id])
  currentPoints  Int         @default(0)
  lifetimePoints Int         @default(0)
  upgradedAt     DateTime?
  downgradedAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([customerId, organizationId])
  @@index([customerId])
  @@index([organizationId])
  @@map("customerTier")
}

model LoyaltyStatement {
  id             String   @id @default(uuid())
  customerId     String
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  openingBalance Int      @default(0)
  earnedPoints   Int      @default(0)
  redeemedPoints Int      @default(0)
  expiredPoints  Int      @default(0)
  closingBalance Int      @default(0)
  tierAtStart    String?
  tierAtEnd      String?
  generatedAt    DateTime @default(now())

  @@index([customerId, organizationId])
  @@index([periodEnd])
  @@map("loyaltyStatement")
}

// ─── Loyalty Ledger & Idempotency ───────────────────────

enum LoyaltyLedgerType {
  EARN
  BURN
  EXPIRE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING
  REVERSAL
}

model LoyaltyLedgerEntry {
  id             String            @id @default(uuid())
  customerId     String
  organizationId String
  currencyCode   String
  type           LoyaltyLedgerType
  points         Int
  balanceAfter   Int
  referenceType  String?
  referenceId    String?
  idempotencyKey String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@index([customerId, organizationId, createdAt])
  @@index([customerId, currencyCode, type, createdAt])
  @@index([referenceType, referenceId])
  @@map("loyaltyLedgerEntry")
}

model LoyaltyIdempotency {
  id             String   @id @default(uuid())
  key            String
  operation      String
  organizationId String
  customerId     String?
  requestHash    String
  status         String
  response       Json?
  resourceId     String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([organizationId, operation, key])
  @@index([expiresAt])
  @@map("loyaltyIdempotency")
}

model LoyaltyOutboxEvent {
  id             String    @id @default(uuid())
  organizationId String
  eventType      String
  aggregateId    String
  payload        Json
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([publishedAt, createdAt])
  @@map("loyaltyOutboxEvent")
}

enum LoyaltyWebhookDeliveryStatus {
  PENDING
  PROCESSING
  SUCCESS
  EXHAUSTED
}

model LoyaltyWebhookEndpoint {
  id             String   @id @default(uuid())
  organizationId String
  url            String
  secret         String
  events         String[] @default([])
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries LoyaltyWebhookDelivery[]

  @@index([organizationId, isActive])
  @@map("loyaltyWebhookEndpoint")
}

model LoyaltyWebhookDelivery {
  id             String                       @id @default(uuid())
  endpointId     String
  endpoint       LoyaltyWebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  outboxEventId  String
  organizationId String
  eventType      String
  payload        Json
  status         LoyaltyWebhookDeliveryStatus @default(PENDING)
  attempts       Int                          @default(0)
  maxAttempts    Int                          @default(6)
  nextAttemptAt  DateTime                     @default(now())
  responseStatus Int?
  responseBody   String?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([endpointId, outboxEventId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("loyaltyWebhookDelivery")
}

// ─── Promo / Discount Engine ────────────────────────────

model PromoCode {
  id                 String            @id @default(uuid())
  organizationId     String
  code               String            @unique
  name               String?
  description        String?
  discountType       String // PERCENTAGE | ABSOLUTE | FREE_SHIPPING | BOGO
  discountValue      Decimal           @db.Decimal(10, 2)
  minOrderAmount     Decimal?          @db.Decimal(10, 2)
  maxDiscount        Decimal?          @db.Decimal(10, 2)
  usageLimit         Int? // total uses allowed
  perUserLimit       Int?              @default(1)
  usedCount          Int               @default(0)
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean           @default(true)
  isStackable        Boolean           @default(false)
  applicableProducts Json? // product/category filters
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  redemptions        PromoRedemption[]

  @@index([organizationId])
  @@index([code])
  @@map("promoCode")
}

model PromoRedemption {
  id             String    @id @default(uuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id])
  customerId     String
  organizationId String
  orderRef       String?
  discountAmount Decimal   @db.Decimal(10, 2)
  orderAmount    Decimal   @db.Decimal(10, 2)
  redeemedAt     DateTime  @default(now())

  @@index([promoCodeId])
  @@index([customerId])
  @@index([organizationId])
  @@map("promoRedemption")
}

// ─── PLB Engine ─────────────────────────────────────────

model PLBProgram {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  description       String?
  cycleType         String // MONTHLY | QUARTERLY | ANNUAL | CUSTOM
  cycleStart        DateTime
  cycleEnd          DateTime
  metricDefinitions Json // [{ name, type, target, weight }]
  slabDefinitions   Json // [{ min, max, incentiveType, incentiveValue }]
  status            String   @default("DRAFT") // DRAFT | ACTIVE | CLOSED | ARCHIVED
  approvalRequired  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("plbProgram")
}

model PLBMetric {
  id             String   @id @default(uuid())
  programId      String
  entityId       String // customer/partner/agent
  entityType     String   @default("CUSTOMER")
  metricName     String
  metricValue    Decimal  @db.Decimal(18, 6)
  targetValue    Decimal  @db.Decimal(18, 6)
  achievementPct Decimal  @db.Decimal(5, 2)
  periodStart    DateTime
  periodEnd      DateTime
  recordedAt     DateTime @default(now())

  @@unique([programId, entityId, periodStart, periodEnd, metricName], name: "plb_metric_period_unique")
  @@index([programId, entityId])
  @@index([periodEnd])
  @@map("plbMetric")
}

model PLBBonus {
  id             String    @id @default(uuid())
  programId      String
  entityId       String
  cycleStart     DateTime
  cycleEnd       DateTime
  slabName       String?
  incentiveType  String // CASH | POINTS | CREDIT | VOUCHER
  incentiveValue Decimal   @db.Decimal(18, 6)
  currency       String    @default("INR")
  status         String    @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  approvedBy     String?
  approvedAt     DateTime?
  payoutRef      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([programId, entityId, cycleStart, cycleEnd], name: "plb_bonus_cycle_unique")
  @@index([programId, entityId])
  @@index([status])
  @@map("plbBonus")
}

// ─── Value Exchange Engine ──────────────────────────────

model ExchangeAgreement {
  id              String    @id @default(uuid())
  name            String
  sourceEntityId  String // source organization/partner
  targetEntityId  String // target organization/partner
  sourceCurrency  String // source loyalty currency code
  targetCurrency  String // target loyalty currency code
  conversionRatio Decimal   @db.Decimal(10, 6) // 1 source = X target
  minAmount       Int? // minimum exchange amount
  maxAmount       Int? // maximum per transaction
  dailyCap        Int? // daily limit
  monthlyCap      Int? // monthly limit
  isActive        Boolean   @default(true)
  trustModel      String    @default("BILATERAL") // BILATERAL | PLATFORM_MEDIATED | CONSORTIUM
  settlementModel String    @default("REAL_TIME") // REAL_TIME | DEFERRED
  breakageOwner   String    @default("ISSUER") // ISSUER | PLATFORM | SHARED
  version         Int       @default(1)
  effectiveFrom   DateTime  @default(now())
  effectiveUntil  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([sourceEntityId, targetEntityId, sourceCurrency, targetCurrency])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("exchangeAgreement")
}

model ExchangeQuote {
  id               String    @id @default(uuid())
  agreementId      String
  sourceEntityId   String
  sourceCustomerId String
  sourceAmount     Int
  targetAmount     Int
  sourceCurrency   String
  targetCurrency   String
  conversionRatio  Decimal   @db.Decimal(10, 6)
  spread           Decimal   @db.Decimal(10, 6)
  effectiveRate    Decimal   @db.Decimal(10, 6)
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([sourceEntityId, sourceCustomerId])
  @@index([expiresAt])
  @@map("exchangeQuote")
}

model ExchangeOrder {
  id               String    @id @default(uuid())
  agreementId      String
  sourceEntityId   String
  targetEntityId   String
  sourceCustomerId String
  targetCustomerId String?
  sourceAmount     Int
  targetAmount     Int
  conversionRate   Decimal   @db.Decimal(10, 6)
  status           String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | REVERSED | FAILED
  reversalReason   String?
  reversedAt       DateTime?
  referenceId      String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([agreementId])
  @@index([sourceCustomerId])
  @@index([targetCustomerId])
  @@index([status])
  @@map("exchangeOrder")
}

model ExchangeAuditLog {
  id              String   @id @default(uuid())
  exchangeOrderId String
  action          String // QUOTED | EXECUTED | REVERSED | FAILED
  details         Json?
  createdAt       DateTime @default(now())

  @@index([exchangeOrderId])
  @@map("exchangeAuditLog")
}
